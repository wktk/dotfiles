# A personal ~/.inputrc replaces /etc/inputrc, so keep the system bindings.
$include /etc/inputrc

# Other programs using readline (irb, psql, python) read this file too.
$if Bash
  set completion-ignore-case on
  # Tab completes the common prefix and lists the candidates, then cycles
  # through them; Shift-Tab cycles backward.
  set show-all-if-ambiguous on
  set menu-complete-display-prefix on
  TAB: menu-complete
  "\e[Z": menu-complete-backward
  set colored-stats on
  set colored-completion-prefix on
  set mark-symlinked-directories on

  # Ctrl-W deletes back to "/" like zsh's WORDCHARS in .shell/rc. Without
  # turning off bind-tty-special-chars, the tty's werase wins over this.
  set bind-tty-special-chars off
  "\C-w": unix-filename-rubout

  # Word moves with Ctrl or Option/Alt + arrows.
  "\e[1;5D": backward-word
  "\e[1;5C": forward-word
  "\e[1;3D": backward-word
  "\e[1;3C": forward-word
  "\e\e[D": backward-word
  "\e\e[C": forward-word

  "\e[A": history-substring-search-backward
  "\eOA": history-substring-search-backward
  "\C-p": history-substring-search-backward
  "\e[B": history-substring-search-forward
  "\eOB": history-substring-search-forward
  "\C-n": history-substring-search-forward
$endif
