[user]
	email = k.wakitani@gmail.com
	name = k.wakitani
[core]
	precomposeUnicode = true
	commentChar = ";"
# Keep this before [url]: when two insteadOf rules match equally, git uses the
# one read first, so ~/.gitconfig_local can override them (e.g. with SSH).
[include]
	path = ~/.gitconfig_local
[alias]
	merged-branch = !git branch --merged | grep -v '^\\(+\\|*\\)\\|\\(master\\|develop\\|main\\|release\\)$' | xargs git branch -d
	dj = diff --word-diff-regex=$'[^\\x80-\\xbf][\\x80-\\xbf]*' --word-diff=color
	sw = switch
	fixup = commit --amend --no-edit
	graph = log --graph --all --format='%x09%ad %h %d %ae%x09%s' --no-show-signature --date=short
	pushf = push --force-with-lease --force-if-includes
[url "https://github.com/"]
	insteadOf = github:
[url "https://github.com/wktk/"]
	insteadOf = wktk:
[gpg "x509"]
	program = smimesign
[stash]
	showPatch = true
[rebase]
	autosquash = true
[rerere]
	enabled = true
[tag]
	gpgSign = true
[pull]
	ff = only
[init]
	defaultBranch = main
[gpg "ssh"]
	allowedSignersFile = ~/.ssh/allowed_signers
